from __future__ import annotations

import heapq
from typing import Hashable


Node = Hashable
Graph = dict[Node, list[tuple[Node, float]]]


def shortest_paths(
    graph: Graph,
    start: Node,
) -> tuple[dict[Node, float], dict[Node, Node | None]]:

    if start not in graph:
        raise ValueError(f"Unknown start node: {start}")

    distance = {
        node: float("inf")
        for node in graph
    }

    previous = {
        node: None
        for node in graph
    }

    distance[start] = 0.0

    queue = [(0.0, start)]

    while queue:
        current_distance, current = heapq.heappop(queue)

        if current_distance != distance[current]:
            continue

        for neighbor, weight in graph[current]:

            if weight < 0:
                raise ValueError(
                    "Dijkstra does not support negative weights"
                )

            candidate = current_distance + weight

            if candidate < distance.get(
                neighbor,
                float("inf"),
            ):
                distance[neighbor] = candidate
                previous[neighbor] = current

                heapq.heappush(
                    queue,
                    (candidate, neighbor),
                )

    return distance, previous


def path_to(
    previous: dict[Node, Node | None],
    start: Node,
    target: Node,
) -> list[Node]:

    if target not in previous:
        return []

    path = []
    current: Node | None = target

    while current is not None:
        path.append(current)

        if current == start:
            path.reverse()
            return path

        current = previous[current]

    return []
